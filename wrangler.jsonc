{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expound",
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "expoundlabs.io",     "custom_domain": true },
    { "pattern": "www.expoundlabs.io", "custom_domain": true }
  ]
}
